# --- secaudit recommended ---
# Single source: `secaudit init` writes this block. Do not hand-maintain a copy.
#
# As a global ignore:  git config --global core.excludesfile ~/.gitignore_global
# Or as a repo .gitignore.

# --- Secrets and credentials ---
.env
.env.*
!.env.example
!.env.template
!.env.sample

*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
!*.pub
id_rsa*
id_ed25519*

credentials.json
client_secret*.json
service-account*.json
serviceaccount*.json
gcp-key*.json
gha-creds-*.json

.netrc
.npmrc
.pypirc
.htpasswd

# Cloud and provider CLI state - these hold live tokens
.aws/
.azure/
.gcloud/
.config/gcloud/
.doctl/
.netlify/
.vercel/
.supabase/
.wrangler/
terraform.tfvars
*.auto.tfvars
.terraform/
*.tfstate
*.tfstate.*

# --- AI assistant and agent sessions ---
# These record whatever the tool read while working, including credentials
# from your config files, plus hidden text that can be decoded back to English.
.claude/
.codex/
.hermes/
.openclaw/
.cursor/
.aider*
.continue/
.windsurf/

sessions/
session/
traces/
trace/
transcripts/
conversations/
agent-runs/
runs/

*.jsonl
*.trace.json
*-transcript.json
*-session.json

.mcp/
mcp-config.local.json
*.mcp.local.json

# --- Logs (payloads and tokens leak here) ---
logs/
log/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Data: client records, production dumps, exports ---
data/raw/
data/private/
data/client/
dumps/
backups/
*.sql
*.sql.gz
*.dump
*.bak
*.sqlite
*.sqlite3
dump.rdb
# Schema migrations are .sql but belong in git. Same naming conventions the
# SEC-204 rule uses: a version prefix, or a golang-migrate direction suffix.
!*.up.sql
!*.down.sql
![0-9]*_*.sql

# Uncomment if this repo should never carry tabular data.
# Leave commented if you commit fixtures, and whitelist those explicitly.
# *.csv
# *.xlsx
# *.parquet

# --- Scanner output: contains the findings, and fragments of your secrets ---
secaudit-report.*
gitleaks-report.json
trufflehog-report.json
.secrets.baseline
reports/
.secaudit/

# --- Language and framework ---
# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Node
node_modules/
dist/
build/
.next/
.nuxt/
.svelte-kit/
coverage/
.turbo/
.parcel-cache/

# Odoo
odoo.conf
odoo-server.conf
filestore/
.odoo/

# Docker - compose overrides often hold real values
docker-compose.override.yml
docker-compose.*.local.yml

# --- OS and editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json

# --- Local scratch ---
tmp/
temp/
scratch/
*.local
*.local.*
NOTES.local.md
TODO.local.md
# --- end secaudit recommended ---
